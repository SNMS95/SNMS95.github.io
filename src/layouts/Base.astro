---
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Motif from '../components/Motif.astro';
import { profile, REPO_URL } from '../lib/data';
import { getPublishedPosts } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  /** Show the name next to the mark (the landing page has it as its h1 instead). */
  showName?: boolean;
}
const { title, description, showName = true } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const hasPosts = (await getPublishedPosts()).length > 0;
const updated = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: writing`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151413" media="(prefers-color-scheme: dark)" />
    <slot name="head" />
    <script is:inline>
      // Runs before first paint: marks JS as available and restores a saved theme choice.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={showName ? profile.name : `${profile.name}, home`}>
          <Motif />
          {showName && <span>{profile.name}</span>}
        </a>
        <div class="site-nav">
          <nav aria-label="Sections">
            <ul>
              <li><a href="/#papers">Papers</a></li>
              <li><a href="/#code">Code</a></li>
              {hasPosts && <li><a href="/blog/">Writing</a></li>}
            </ul>
          </nav>
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch between light and dark theme">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        Last updated {updated}{' · '}<a href="/rss.xml">RSS</a>{' · '}<a href={REPO_URL}>Source</a>
      </div>
    </footer>

    <script>
      const root = document.documentElement;

      // Theme toggle: flips the effective theme and remembers it (storage may be blocked).
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      // BibTeX: copy to clipboard, with a textarea fallback for non-secure contexts.
      async function copyText(text: string): Promise<boolean> {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.append(ta);
          ta.select();
          let ok = false;
          try {
            ok = document.execCommand('copy');
          } catch {}
          ta.remove();
          return ok;
        }
      }
      document.querySelectorAll<HTMLButtonElement>('[data-bibtex]').forEach((btn) => {
        const label = btn.querySelector('span');
        btn.addEventListener('click', async () => {
          const ok = await copyText(btn.dataset.bibtex ?? '');
          if (!label) return;
          label.textContent = ok ? 'Copied' : 'Copy failed';
          setTimeout(() => (label.textContent = 'BibTeX'), 1600);
        });
      });
    </script>
  </body>
</html>
