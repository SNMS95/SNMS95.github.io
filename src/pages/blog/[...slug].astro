---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} · Surya Manoj Sanu`} description={post.data.summary}>
  <article class="post">
    <h1>{post.data.title}</h1>
    <p class="role">
      <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
      {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
    </p>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/blog/">All posts</a></p>
  </article>
</Base>
