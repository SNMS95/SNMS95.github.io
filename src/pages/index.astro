---
import Base from '../layouts/Base.astro';
import Paper from '../components/Paper.astro';
import Project from '../components/Project.astro';
import PostList from '../components/PostList.astro';
import { profile, papers, software, talks } from '../lib/data';
import { getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
const description =
  'Surya Manoj Sanu: machine learning for physical simulation and design. PhD (thesis submitted), TU Delft. Papers, software and notes.';
---

<Base title={profile.name} description={description} showName={false}>
  <section class="intro" aria-labelledby="top">
    <h1 id="top">{profile.name}</h1>
    <p class="role">{profile.role} · {profile.location}</p>
    {profile.intro.map((p) => <p>{p}</p>)}
    <ul class="inline-list links">
      {
        profile.links.map((l) => (
          <li>
            <a href={l.url} rel={l.url.startsWith('http') ? 'me' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="papers" aria-labelledby="papers-h">
    <h2 class="label" id="papers-h">Papers</h2>
    {papers.map((paper) => <Paper paper={paper} />)}
  </section>

  <section id="code" aria-labelledby="code-h">
    <h2 class="label" id="code-h">Software &amp; contributions</h2>
    {software.projects.map((project) => <Project project={project} />)}

    <div class="compact">
      <span class="k">Contributions to</span>
      <ul class="inline-list">
        {
          software.contributions.map((c) => (
            <li>
              <a href={c.url}>{c.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="talks" aria-labelledby="talks-h">
    <h2 class="label" id="talks-h">Talks</h2>
    <ul class="inline-list">
      {
        talks.map((t) => (
          <li>
            <abbr title={t.full}>{t.name}</abbr> {t.years}
          </li>
        ))
      }
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section id="writing" aria-labelledby="writing-h">
        <h2 class="label" id="writing-h">Writing</h2>
        <PostList posts={posts} />
        <p><a href="/blog/">All posts</a></p>
      </section>
    )
  }
</Base>
